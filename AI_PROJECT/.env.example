# Máy chủ MySQL. 127.0.0.1 nghĩa là MySQL trên cùng máy với ứng dụng.
# Khi máy khác kết nối tới server trong cùng mạng, đổi thành IP nội bộ của máy chủ.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chi_tieu_sinh_vien

# Thay bằng tài khoản MySQL riêng dành cho ứng dụng.
DB_USER=expense_app
DB_PASSWORD=Quang3627

# Gemini API. Lấy API key từ Google AI Studio và chọn model được tài khoản hỗ trợ.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=your_gemini_model

